# LOCAL DEMO ONLY. Copy to .env. Never commit .env or a database.
# Production must use DEBUG=False, ALLOW_DEMO_LOGIN=False and fresh secrets.
DEBUG=True
ALLOW_DEMO_LOGIN=True
# Blank is safe in DEBUG: a random key is generated on startup (sessions reset).
# Production requires a new random secret of at least 50 characters.
SECRET_KEY=
ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
APP_BASE_URL=http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000
OIDC_REDIRECT_URI=http://127.0.0.1:8000/auth/callback/

# Leave all three blank for local demo. Get them from school IT for real SSO.
# Use the exact school/tenant issuer, never a public or multi-tenant issuer.
OIDC_PROVIDER=generic
# Microsoft 365/Teams schools: OIDC_PROVIDER=microsoft, then use the exact
# https://login.microsoftonline.com/TENANT-UUID/v2.0 issuer supplied by IT.
# Microsoft registrations commonly use OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic

# Omit DATABASE_URL for local db.sqlite3. Production example (set a real secret):
# DATABASE_URL=postgresql://grades:password@database:5432/grades?sslmode=require
# Enable ONLY when your trusted proxy strips/replaces X-Forwarded-Proto.
TRUST_PROXY_HEADERS=False
